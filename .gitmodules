[submodule "system/ch32h417lib"]
	path = system/ch32h417lib
	url = https://github.com/maxgerhardt/ch32h417lib.git
[submodule "ArduinoCore-API"]
	path = ArduinoCore-API
	url = https://github.com/arduino/ArduinoCore-API.git
# A fork, on branch ch32h417, because upstream cannot build for this part.
#
# It replaces the bundled TinyUSB 0.20 with 0.21 from maxgerhardt/tinyusb
# (branch ch32h417-v2) -- the only version carrying OPT_MCU_CH32H417 and the
# USBFS dcd for this silicon -- and adds an ARDUINO_ARCH_CH32H4 branch to the
# tusb_config dispatcher. Upstream's own ch32 port is guarded on
# ARDUINO_ARCH_CH32 / CH32V20x / CH32V30x and targets the fsdev/USBHD IPs of
# the CH32V series, where the H41x has the newer USBFS on OTG_FS.
#
# Check out upstream instead and the build fails with "TinyUSB Arduino Library
# does not support your core yet", which is the dispatcher saying exactly this.
[submodule "libraries/Adafruit_TinyUSB_Arduino"]
	path = libraries/Adafruit_TinyUSB_Arduino
	url = https://github.com/Community-PIO-CH32V/Adafruit_TinyUSB_Arduino.git
	branch = ch32h417
[submodule "system/lwip"]
	path = system/lwip
	url = https://github.com/lwip-tcpip/lwip.git
[submodule "libraries/Adafruit_SleepyDog"]
	path = libraries/Adafruit_SleepyDog
	url = https://github.com/Community-PIO-CH32V/Adafruit_SleepyDog.git
	branch = ch32h4
# A fork, on branch ch32h4, because mbedTLS's own layout cannot be an Arduino
# library and this core wants it to be one -- so that a sketch's #include
# decides whether TLS is in the build, rather than a flag someone has to know
# to set.
#
# The cryptography is untouched. The branch prunes programs/, tests/,
# scripts/, framework/ and 3rdparty/ -- arduino-cli compiles every directory
# under a library's src/ recursively with no way to exclude one, and
# programs/ is full of main() -- flattens include/mbedtls and library/ into
# the single include root an Arduino library gets, carries this core's
# mbedtls_config.h in the place mbedTLS looks by default, and brings the
# CH32H41x port (aes_alt.c on the ECDC block, entropy from the TRNG) with it.
#
# README-ch32h4.md on that branch says all of this again, for someone who
# arrives at the fork without this file.
[submodule "libraries/mbedtls/src"]
	path = libraries/mbedtls/src
	url = https://github.com/Community-PIO-CH32V/mbedtls.git
	branch = ch32h4
